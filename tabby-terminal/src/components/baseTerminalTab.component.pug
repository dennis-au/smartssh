.terminal-toolbar-spacer
.content(#content, [style.opacity]='frontendIsReady ? 1 : 0')
search-panel(
    *ngIf='showSearchPanel && frontend',
    [class.d-none]='!hasFocus',
    @toolbarSlide,
    [@.disabled]='!config.store.accessibility.animations',
    [frontend]='frontend',
    (close)='showSearchPanel = false; frontend.cancelSearch()'
)

smartssh-bar(*ngIf='smartsshProposal', [model]='smartsshProposal')
.smartssh-trust(
    [attr.data-smartssh-armed]='smartsshArmed ? "true" : "false"',
    [attr.data-smartssh-trust]='smartsshArmed ? "readonly_auto" : "off"',
    [class.armed]='smartsshArmed',
    title='SmartSSH 信任狀態'
) {{ smartsshArmed ? '唯讀自動 · 已武裝' : '信任：關' }}

button.btn.btn-sm.btn-link.toolbar-pin-button(
    *ngIf='enableToolbar && !pinToolbar',
    (click)='togglePinToolbar()',
    (mouseenter)='showToolbar()',
    (mouseleave)='hideToolbar()'
)
    i.fas.fa-wrench
